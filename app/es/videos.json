{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "properties": {
      "video_id":     { "type": "keyword" },
      "channel_id":   { "type": "keyword" },
      "title":        { "type": "text", "fields": { "raw": { "type": "keyword" } } },
      "description":  { "type": "text" },
      "tags":         { "type": "keyword" },
      "views":        { "type": "long" },
      "likes":        { "type": "long" },
      "dislikes":     { "type": "long" },
      "published_at": { "type": "date" }
    }
  }
}
